# Gemini API (Single or Multiple Keys with Automatic Round-Robin & Quota Failover)
# Option A: Single key
GEMINI_API_KEY=

# Option B: Comma-separated pool of 4-5 keys for round-robin load balancing
# GEMINI_API_KEYS=key1,key2,key3,key4,key5

# Option C: Numbered keys
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=

# Supabase Configuration
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Vapi Web SDK (Optional)
NEXT_PUBLIC_VAPI_WEB_TOKEN=
